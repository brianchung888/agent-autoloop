{
  "timezone": "Asia/Taipei",
  "sources": {
    "local": { "name": "本機" }
  },
  "agents": {
    "gitlab-py": {
      "name": "GitLab Issue 摘要（Python）",
      "worker": "my-pc",
      "use": "command",
      "command": ["python", "{cwd}/gitlab_issues.py", "--autoloop"]
    }
  },
  "rules": [
    {
      "name": "GitLab 個人 Issue 摘要",
      "when": { "cron": "*/10 8-18 * * *" },
      "to": "gitlab-py",
      "cwd": "~/.agent-autoloop/work/gitlab-issues",
      "tell": "needed"
    }
  ]
}
